{
  "name": "@supcoflow/chat",
  "version": "2.4.0",
  "description": "Supcoflow's embeddable support chat: answers usage questions from your product's guide and files a report when the problem is a bug.",
  "license": "MIT",
  "author": "Supcoflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supcoflow/chat.git"
  },
  "bugs": {
    "url": "https://github.com/supcoflow/chat/issues"
  },
  "homepage": "https://supcoflow.dev",
  "keywords": [
    "supcoflow",
    "chat",
    "intake",
    "bug-report",
    "widget",
    "react",
    "preact"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react-hook/index.d.ts",
      "default": "./dist/hook.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/server": {
      "types": "./dist/testing/server.d.ts",
      "default": "./dist/testing-server.js"
    },
    "./widget.js": "./dist/widget.iife.js",
    "./contract.json": "./contract.json"
  },
  "bin": {
    "supcoflow-chat-fake": "./dist/fake-server.js"
  },
  "files": [
    "dist",
    "docs",
    "contract.json",
    "examples",
    "!examples/**/*.test.ts",
    "!examples/**/*.test.tsx",
    "!examples/react/tsconfig.json",
    "conformance",
    "!conformance/**/*.test.ts",
    "!conformance/**/*.test.tsx",
    "!conformance/broken-chat.tsx",
    "!conformance/tsconfig.json",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p examples/react && tsc --noEmit -p conformance"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.0",
    "preact": "10.28.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
